{
  "name": "fund-risks-analysis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute fund_risks --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute fund_risks --remote --file=./schema.sql",
    "db:migrate": "wrangler d1 execute fund_risks --local --file=./migrations/0001_add_ret_3m_6m.sql",
    "db:migrate:remote": "wrangler d1 execute fund_risks --remote --file=./migrations/0001_add_ret_3m_6m.sql",
    "ingest:local": "curl -s -X POST http://localhost:8787/admin/ingest | tail -1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.0.0"
  }
}
